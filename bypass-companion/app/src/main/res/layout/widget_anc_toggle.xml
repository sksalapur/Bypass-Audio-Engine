<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_anc_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_anc_bg"
    android:paddingLeft="12dp"
    android:paddingRight="12dp"
    android:paddingTop="7dp"
    android:paddingBottom="7dp"
    android:gravity="center_vertical">

    <!-- Header Row: Device Name, Status, and Battery Indicator -->
    <LinearLayout
        android:id="@+id/anc_header_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <!-- Device Name & Status Text -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/anc_device_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🎧 Buds T500 Pro"
                android:textColor="#E6EDF3"
                android:textSize="11sp"
                android:textStyle="bold"
                android:singleLine="true"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/anc_status_badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="6dp"
                android:text="• ANC"
                android:textColor="#4EBA6F"
                android:textSize="10sp"
                android:textStyle="bold"
                android:singleLine="true" />
        </LinearLayout>

        <!-- Actions Container: Battery Badge & Dedicated Refresh Button -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <!-- Battery Indicator Badge (Tappable to refresh) -->
            <LinearLayout
                android:id="@+id/anc_btn_refresh_battery"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/widget_battery_badge_green"
                android:paddingLeft="8dp"
                android:paddingRight="8dp"
                android:paddingTop="3dp"
                android:paddingBottom="3dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/anc_battery_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🔋 90%"
                    android:textColor="#4EBA6F"
                    android:textSize="10.5sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Dedicated Large Refresh Button -->
            <ImageView
                android:id="@+id/anc_btn_refresh"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:layout_marginLeft="6dp"
                android:background="@drawable/widget_refresh_circle"
                android:contentDescription="Refresh Earbuds Status"
                android:padding="5dp"
                android:src="@drawable/ic_widget_refresh" />
        </LinearLayout>
    </LinearLayout>

    <!-- Controls Row: 3 Circular Horizontal Mode Buttons -->
    <LinearLayout
        android:id="@+id/anc_buttons_row"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="5dp"
        android:orientation="horizontal"
        android:gravity="center">

        <!-- 1. ANC Mode Button -->
        <LinearLayout
            android:id="@+id/btn_mode_anc"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginLeft="2dp"
            android:layout_marginRight="2dp"
            android:background="@drawable/btn_anc_active"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingTop="2dp"
            android:paddingBottom="2dp">

            <TextView
                android:id="@+id/text_anc_icon"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🛡️"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/text_anc_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ANC"
                android:textColor="#4EBA6F"
                android:textSize="10sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- 2. Normal / Off Mode Button -->
        <LinearLayout
            android:id="@+id/btn_mode_normal"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginLeft="2dp"
            android:layout_marginRight="2dp"
            android:background="@drawable/btn_anc_inactive"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingTop="2dp"
            android:paddingBottom="2dp">

            <TextView
                android:id="@+id/text_normal_icon"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="⚪"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/text_normal_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Normal"
                android:textColor="#8B949E"
                android:textSize="10sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- 3. Transparency / Ambient Mode Button -->
        <LinearLayout
            android:id="@+id/btn_mode_transparency"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginLeft="2dp"
            android:layout_marginRight="2dp"
            android:background="@drawable/btn_anc_inactive"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingTop="2dp"
            android:paddingBottom="2dp">

            <TextView
                android:id="@+id/text_transparency_icon"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🔊"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/text_transparency_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Ambient"
                android:textColor="#8B949E"
                android:textSize="10sp"
                android:textStyle="bold" />
        </LinearLayout>

    </LinearLayout>

</LinearLayout>

