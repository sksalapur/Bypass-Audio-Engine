<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_card_bg"
    android:orientation="vertical"
    android:paddingStart="12dp"
    android:paddingTop="9dp"
    android:paddingEnd="12dp"
    android:paddingBottom="9dp">

    <!-- Card Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="4dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/widget_header_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:letterSpacing="0.06"
            android:text="HARDWARE AUDIO SIGNAL CHAIN"
            android:textColor="#D4AF37"
            android:textSize="9.5sp"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/widget_btn_refresh"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:background="@drawable/widget_refresh_circle"
            android:contentDescription="Refresh Telemetry"
            android:padding="5dp"
            android:src="@drawable/ic_widget_refresh" />
    </LinearLayout>

    <!-- 5-Node Rail Flex Container -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <!-- Node 01: Source -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="22dp"
                android:layout_height="match_parent"
                android:gravity="center_horizontal"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/node1_index"
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:background="@drawable/widget_node_gold"
                    android:gravity="center"
                    android:text="01"
                    android:textColor="#D4AF37"
                    android:textSize="8.5sp"
                    android:textStyle="bold" />

                <ImageView
                    android:id="@+id/node1_line"
                    android:layout_width="1.5dp"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:background="@drawable/widget_track_line" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="7dp"
                android:layout_weight="1"
                android:gravity="center_vertical"
                android:orientation="vertical"
                android:paddingBottom="2dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/node1_title"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:text="BitChord Track"
                        android:textColor="#F3F4F6"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/node1_badge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="5dp"
                        android:background="@drawable/widget_badge_gold"
                        android:text="ACTIVE STREAM"
                        android:textColor="#D4AF37"
                        android:textSize="7.5sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <TextView
                    android:id="@+id/node1_subtitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="BitChord • FLAC • 96.0 kHz / 24-bit"
                    android:textColor="#9CA3AF"
                    android:textSize="9.5sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Node 02: Decoder -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="22dp"
                android:layout_height="match_parent"
                android:gravity="center_horizontal"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/node2_index"
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:background="@drawable/widget_node_green"
                    android:gravity="center"
                    android:text="02"
                    android:textColor="#4EBA6F"
                    android:textSize="8.5sp"
                    android:textStyle="bold" />

                <ImageView
                    android:id="@+id/node2_line"
                    android:layout_width="1.5dp"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:background="@drawable/widget_track_line" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="7dp"
                android:layout_weight="1"
                android:gravity="center_vertical"
                android:orientation="vertical"
                android:paddingBottom="2dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/node2_title"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:text="c2.android.flac.decoder / FFmpeg"
                        android:textColor="#F3F4F6"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/node2_badge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="5dp"
                        android:background="@drawable/widget_badge_green"
                        android:text="DECODED"
                        android:textColor="#4EBA6F"
                        android:textSize="7.5sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <TextView
                    android:id="@+id/node2_subtitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="AudioTrack Float32"
                    android:textColor="#9CA3AF"
                    android:textSize="9.5sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Node 03: Resampler -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="22dp"
                android:layout_height="match_parent"
                android:gravity="center_horizontal"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/node3_index"
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:background="@drawable/widget_node_amber"
                    android:gravity="center"
                    android:text="03"
                    android:textColor="#F59E0B"
                    android:textSize="8.5sp"
                    android:textStyle="bold" />

                <ImageView
                    android:id="@+id/node3_line"
                    android:layout_width="1.5dp"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:background="@drawable/widget_track_line" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="7dp"
                android:layout_weight="1"
                android:gravity="center_vertical"
                android:orientation="vertical"
                android:paddingBottom="2dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/node3_title"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:text="AudioFlinger Resampler"
                        android:textColor="#F3F4F6"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/node3_badge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="5dp"
                        android:background="@drawable/widget_badge_amber"
                        android:text="MIXER ACTIVE"
                        android:textColor="#F59E0B"
                        android:textSize="7.5sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <TextView
                    android:id="@+id/node3_subtitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="Resampling Ratio: Mixer ➔ 96.0 kHz"
                    android:textColor="#9CA3AF"
                    android:textSize="9.5sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Node 04: DSP -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="22dp"
                android:layout_height="match_parent"
                android:gravity="center_horizontal"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/node4_index"
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:background="@drawable/widget_node_blue"
                    android:gravity="center"
                    android:text="04"
                    android:textColor="#60A5FA"
                    android:textSize="8.5sp"
                    android:textStyle="bold" />

                <ImageView
                    android:id="@+id/node4_line"
                    android:layout_width="1.5dp"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:background="@drawable/widget_track_line" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="7dp"
                android:layout_weight="1"
                android:gravity="center_vertical"
                android:orientation="vertical"
                android:paddingBottom="2dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/node4_title"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:text="System Audio Pipeline"
                        android:textColor="#F3F4F6"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/node4_badge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="5dp"
                        android:background="@drawable/widget_badge_blue"
                        android:text="A2DP STACK"
                        android:textColor="#60A5FA"
                        android:textSize="7.5sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <TextView
                    android:id="@+id/node4_subtitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="Volume Truncation: Software Scaled"
                    android:textColor="#9CA3AF"
                    android:textSize="9.5sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Node 05: Endpoint -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="22dp"
                android:layout_height="match_parent"
                android:gravity="center_horizontal"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/node5_index"
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:background="@drawable/widget_node_blue"
                    android:gravity="center"
                    android:text="05"
                    android:textColor="#60A5FA"
                    android:textSize="8.5sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="7dp"
                android:layout_weight="1"
                android:gravity="center_vertical"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/node5_title"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:text="realme Buds T500 Pro"
                        android:textColor="#F3F4F6"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/node5_badge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="5dp"
                        android:background="@drawable/widget_badge_blue"
                        android:text="HI-RES WIRELESS"
                        android:textColor="#60A5FA"
                        android:textSize="7.5sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <TextView
                    android:id="@+id/node5_subtitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="LHDC v5 Encoder • 96.0 kHz • 24-bit"
                    android:textColor="#9CA3AF"
                    android:textSize="9.5sp" />
            </LinearLayout>
        </LinearLayout>

    </LinearLayout>

</LinearLayout>
